#!/usr/bin/env bash
#
# bin/gate — keyholder's gate.
#
# The whole verification of this packet, and nothing else is needed: no
# database, no network, no cluster. It builds the binary, vets the source,
# lints it the way CI does, formats it, runs the suite, and renders the
# chart to prove the image digest the publish writes reaches the Deployment.
# (`helm`, the renderer, is the one extra tool that step needs on PATH.)
#
#   ./bin/gate          run the whole gate
#   ./bin/gate --help   this header
#
# Exit 0 means: the binary builds, `go vet ./...` is clean, golangci-lint over
# kit's config is clean, gofmt has nothing to say about the source,
# `go test ./...` passes, and the chart renders the published image by the
# committed digest — and refuses one that is malformed. Anything else is
# nonzero with the failing step named.

set -euo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      sed -n '3,18p' "$0"
      exit 0
      ;;
    *)
      echo "bin/gate: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

cd "$(dirname "$0")/.."

fail() {
  printf '\n== gate RED: %s\n' "$1" >&2
  exit 1
}

echo "== build =="
go build -o bin/keyholder ./cmd/keyholder || fail "the binary does not build"

echo "== vet =="
go vet ./... || fail "go vet found problems"

echo "== lint =="
# THE LINT THAT CI RUNS, AND THE VERSION IT RUNS AT.
#
# kit's ci.reusable.yml runs `golangci/golangci-lint-action@v9` with
# `version: v2.14.0` and `--config` pointing at kit's `lint/golangci.yml`.
# This step runs the SAME lint, at the SAME version, over the SAME config, and
# a finding fails the gate. The version is pinned in two places — this
# repository's `mise.toml` (`golangci-lint = "2.14.0"`) and kit's workflow — so
# a bump touches both in the same commit. An unpinned local install or a CI run
# on `latest` is how `bin/gate` stayed green while CI went red.
#
# THE CONFIG IS NOT COPIED. kit's `lint/golangci.yml` header says "Not copied
# into a service repo" because a copy is a second policy to drift. The config
# is read from kit's checkout, and the location is resolved rather than
# assumed: in CI it is at `.kit/lint/golangci.yml` (sparse checkout), locally
# it is at `../kit/lint/golangci.yml` (moon workspace), and either may be
# absent.
#
# THE TOOL MUST BE PRESENT. A step that quietly skips when the linter is absent
# is the whole defect: a green that verified nothing. `mise install` provides
# the pinned version; a bare `go` toolchain without it fails here rather than
# passing.
if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "bin/gate: golangci-lint is not on PATH — run 'mise install' in this worktree" >&2
  echo "  (mise.toml pins golangci-lint = \"2.14.0\", the same version CI runs)" >&2
  exit 127
fi
pinned_lint="$(sed -n 's/^"golangci-lint" *= *"\(.*\)"/\1/p' mise.toml)"
if [ -n "$pinned_lint" ]; then
  actual_lint="$(golangci-lint --version 2>&1 | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | head -n1 | sed 's/^v//')"
  if [ -n "$actual_lint" ] && [ "$actual_lint" != "$pinned_lint" ]; then
    echo "bin/gate: golangci-lint is $actual_lint, and mise.toml pins $pinned_lint." >&2
    echo "  Run 'mise install' in this worktree. Continuing would report lint" >&2
    echo "  findings from a different version than CI, which is how the gate" >&2
    echo "  stayed green while CI went red." >&2
    exit 1
  fi
fi
kit_config=""
for candidate in ".kit/lint/golangci.yml" "../kit/lint/golangci.yml" "lint/golangci.yml"; do
  if [ -f "$candidate" ]; then
    kit_config="$candidate"
    break
  fi
done
if [ -z "$kit_config" ]; then
  echo "bin/gate: kit's lint config not found — tried .kit/lint/golangci.yml," >&2
  echo "  ../kit/lint/golangci.yml, and lint/golangci.yml. In CI the kit checkout" >&2
  echo "  provides .kit; locally the moon workspace provides ../kit." >&2
  exit 1
fi
echo "lint config: $kit_config"
echo "lint version: $(golangci-lint --version 2>&1 | head -n1)"
golangci-lint run --config "$kit_config" ./... || fail "golangci-lint found problems"

echo "== fmt =="
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  printf 'gofmt would rewrite:\n%s\n' "$unformatted" >&2
  fail "the source is not gofmt-clean"
fi

echo "== test =="
go test -count=1 ./... || fail "the suite is red"

echo "== chart =="
# THE IMAGE DIGEST, STATICALLY AND RENDERED — the half of the publish loop
# THIS repository owns. kit's `chart.reusable.yml` writes `image.digest`
# into chart/values.yaml on every publish, from the image job's build
# output, before `helm package`; the Deployment template renders
# `repository@digest` from that value. The measured defect the pair closes
# (roll-c5-image-digest): the tag is a release constant overwritten on
# every master push, so a chart pinned by tag renders IDENTICAL before and
# after a build, Argo's diff reports `Synced`, and the box keeps the old
# image. A digest cannot move, so the render changes and Argo rolls.
#
# A step that quietly skipped when helm is absent is the whole defect — a
# green that verified nothing, exactly as with the linter above — so the
# binary is required rather than optional. kit pins its own copy at v4.3.0
# for `helm package`/`helm push`; this step only RENDERS, and the template
# functions it exercises (`fail`, `regexMatch`, `default`) are stable across
# helm 3 and 4, so the version is printed for the record rather than pinned
# to a second value that would red the gate on a runner's own helm.
values="chart/values.yaml"
image_digest="$(sed -n 's/^  digest:[[:space:]]*//p' "$values" | head -n1 | tr -d "\"'")"
if [ -z "$image_digest" ]; then
  echo "bin/gate: $values sets no image.digest, and the Deployment renders" >&2
  echo "  its container image from exactly that value. The tag alone is" >&2
  echo "  mutable — overwritten on every master push — so a chart pinned by" >&2
  echo "  tag renders IDENTICAL before and after a build and Argo rolls" >&2
  echo "  nothing. The publish run writes this line; the committed value is" >&2
  echo "  the pin a fresh clone renders, so it must be real." >&2
  exit 1
fi
case "$image_digest" in
  sha256:*)
    # The prefix AND the grammar are both asserted, because a digest that is
    # merely PREFIXED right is still a reference no registry answers.
    if ! printf '%s' "$image_digest" | grep -qE '^sha256:[0-9a-f]{64}$'; then
      echo "bin/gate: $values sets image.digest to \"$image_digest\"," >&2
      echo "  which is not sha256:<64 hex> — the manifest digest" >&2
      echo "  chart.reusable.yml writes before helm package. A malformed" >&2
      echo "  digest is worse than an absent one: it renders" >&2
      echo "  repository@nonsense, which LOOKS like a pin and fails at" >&2
      echo "  image-pull with nothing naming this field. bin/chart-test" >&2
      echo "  proves the render refuses it; this step refuses the commit." >&2
      exit 1
    fi
    ;;
  *)
    echo "bin/gate: $values sets image.digest to \"$image_digest\"," >&2
    echo "  which carries no sha256: prefix — the manifest digest" >&2
    echo "  chart.reusable.yml writes before helm package. Drop the key to" >&2
    echo "  render the committed tag, or set a real sha256 digest." >&2
    exit 1
    ;;
esac
echo "chart image: $values pins image.digest $image_digest — immutable, so a new build is a textual diff Argo rolls"
if ! command -v helm >/dev/null 2>&1; then
  echo "bin/gate: helm is not on PATH — bin/chart-test renders the chart with it." >&2
  echo "  kit's publish path pins v4.3.0 (get-helm-3 --version v4.3.0); install" >&2
  echo "  that, or any helm that renders, and re-run. Skipping the render is a" >&2
  echo "  green that verified nothing." >&2
  exit 127
fi
echo "helm version: $(helm version --short 2>&1 | head -n1)"
./bin/chart-test || fail "the chart does not render the published image two ways"

printf '\n== gate GREEN: build, vet, lint, fmt, test, chart ==\n'
