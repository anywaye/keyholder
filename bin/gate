#!/usr/bin/env ruby
# frozen_string_literal: true

# The gate. Two things in it, both small on purpose: rubocop if the fleet's
# config applies, and the suite. It is the same shape the fleet's gates take
# (bin/prime) so a reader who knows one knows the other.
require "fileutils"

ROOT = File.expand_path("..", __dir__)
FileUtils.chdir ROOT

failures = []

def run_step(command, failures)
  puts "== #{command} =="
  return true if system(command)

  failures << command
  false
end

# Style first — it is the cheapest failure and the one that hides the others.
if Gem.loaded_specs.key?("rubocop")
  run_step("bundle exec rubocop --no-color", failures)
else
  puts "== rubocop not installed (no .rubocop.yml yet) =="
end

run_step("bundle exec rake test", failures)

if failures.empty?
  puts "\nGATE GREEN"
  exit 0
else
  puts "\nGATE RED: #{failures.join(', ')}"
  exit 1
end
