#!/usr/bin/env bash
#
# bin/gate — keyholder's gate.
#
# The whole verification of this packet, and nothing else is needed: no
# database, no network, no cluster. It builds the binary, vets the source,
# lints it the way CI does, formats it, and runs the suite.
#
#   ./bin/gate          run the whole gate
#   ./bin/gate --help   this header
#
# Exit 0 means: the binary builds, `go vet ./...` is clean, golangci-lint over
# kit's config is clean, gofmt has nothing to say about the source, and
# `go test ./...` passes. Anything else is nonzero with the failing step named.

set -euo pipefail

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      sed -n '3,18p' "$0"
      exit 0
      ;;
    *)
      echo "bin/gate: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

cd "$(dirname "$0")/.."

fail() {
  printf '\n== gate RED: %s\n' "$1" >&2
  exit 1
}

echo "== build =="
go build -o bin/keyholder ./cmd/keyholder || fail "the binary does not build"

echo "== vet =="
go vet ./... || fail "go vet found problems"

echo "== lint =="
# THE LINT THAT CI RUNS, AND THE VERSION IT RUNS AT.
#
# kit's ci.reusable.yml runs `golangci/golangci-lint-action@v9` with
# `version: v2.14.0` and `--config` pointing at kit's `lint/golangci.yml`.
# This step runs the SAME lint, at the SAME version, over the SAME config, and
# a finding fails the gate. The version is pinned in two places — this
# repository's `mise.toml` (`golangci-lint = "2.14.0"`) and kit's workflow — so
# a bump touches both in the same commit. An unpinned local install or a CI run
# on `latest` is how `bin/gate` stayed green while CI went red.
#
# THE CONFIG IS NOT COPIED. kit's `lint/golangci.yml` header says "Not copied
# into a service repo" because a copy is a second policy to drift. The config
# is read from kit's checkout, and the location is resolved rather than
# assumed: in CI it is at `.kit/lint/golangci.yml` (sparse checkout), locally
# it is at `../kit/lint/golangci.yml` (moon workspace), and either may be
# absent.
#
# THE TOOL MUST BE PRESENT. A step that quietly skips when the linter is absent
# is the whole defect: a green that verified nothing. `mise install` provides
# the pinned version; a bare `go` toolchain without it fails here rather than
# passing.
if ! command -v golangci-lint >/dev/null 2>&1; then
  echo "bin/gate: golangci-lint is not on PATH — run 'mise install' in this worktree" >&2
  echo "  (mise.toml pins golangci-lint = \"2.14.0\", the same version CI runs)" >&2
  exit 127
fi
pinned_lint="$(sed -n 's/^"golangci-lint" *= *"\(.*\)"/\1/p' mise.toml)"
if [ -n "$pinned_lint" ]; then
  actual_lint="$(golangci-lint --version 2>&1 | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | head -n1 | sed 's/^v//')"
  if [ -n "$actual_lint" ] && [ "$actual_lint" != "$pinned_lint" ]; then
    echo "bin/gate: golangci-lint is $actual_lint, and mise.toml pins $pinned_lint." >&2
    echo "  Run 'mise install' in this worktree. Continuing would report lint" >&2
    echo "  findings from a different version than CI, which is how the gate" >&2
    echo "  stayed green while CI went red." >&2
    exit 1
  fi
fi
kit_config=""
for candidate in ".kit/lint/golangci.yml" "../kit/lint/golangci.yml" "lint/golangci.yml"; do
  if [ -f "$candidate" ]; then
    kit_config="$candidate"
    break
  fi
done
if [ -z "$kit_config" ]; then
  echo "bin/gate: kit's lint config not found — tried .kit/lint/golangci.yml," >&2
  echo "  ../kit/lint/golangci.yml, and lint/golangci.yml. In CI the kit checkout" >&2
  echo "  provides .kit; locally the moon workspace provides ../kit." >&2
  exit 1
fi
echo "lint config: $kit_config"
echo "lint version: $(golangci-lint --version 2>&1 | head -n1)"
golangci-lint run --config "$kit_config" ./... || fail "golangci-lint found problems"

echo "== fmt =="
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  printf 'gofmt would rewrite:\n%s\n' "$unformatted" >&2
  fail "the source is not gofmt-clean"
fi

echo "== test =="
go test -count=1 ./... || fail "the suite is red"

printf '\n== gate GREEN: build, vet, lint, fmt, test ==\n'
